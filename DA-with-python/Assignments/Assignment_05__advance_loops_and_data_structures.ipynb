   "source": [
    "## QUESTION 4: While Loop with User Input"
   ]
  },
  {
   "cell_type": "code",
   "id": "1aa88905",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Enter numbers one at a time. Enter -1 to stop.\n",
      "Enter a number: 15\n",
      "Enter a number: 42\n",
      "Enter a number: abc\n",
      "Invalid input. Please enter a whole number.\n",
      "Enter a number: 7\n",
      "Enter a number: 28\n",
      "Enter a number: 3\n",
      "Enter a number: -1\n",
      "\n",
      "Complete list: [15, 42, 7, 28, 3]\n",
      "Largest number: 42\n",
      "Smallest number: 3\n",
      ""
     ]
    }
   ],
   "source": [
    "# List to store the numbers entered by the user\n",
    "user_numbers = []\n",
    "\n",
    "print(\"Enter numbers one at a time. Enter -1 to stop.\")\n",
    "\n",
    "# Keep asking until the user enters -1\n",
    "while True:\n",
    "    entry = input(\"Enter a number: \")\n",
    "\n",
    "    # Handle invalid input (e.g. letters) without crashing\n",
    "    try:\n",
    "        value = int(entry)\n",
    "    except ValueError:\n",
    "        print(\"Invalid input. Please enter a whole number.\")\n",
    "        continue\n",
    "\n",
    "    # Stop the loop when -1 is entered (-1 is not stored)\n",
    "    if value == -1:\n",
    "        break\n",
    "\n",
    "    user_numbers.append(value)\n",
    "\n",
    "# Results after the loop ends\n",
    "if len(user_numbers) == 0:\n",
    "    print(\"No numbers were entered.\")\n",
    "else:\n",
    "    print(\"\\nComplete list:\", user_numbers)\n",
    "    print(\"Largest number:\", max(user_numbers))\n",
    "    print(\"Smallest number:\", min(user_numbers))"
   ]
  },
