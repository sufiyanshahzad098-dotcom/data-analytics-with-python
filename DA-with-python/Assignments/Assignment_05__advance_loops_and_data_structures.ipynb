    "## QUESTION 6: Nested Loops – Multiplication Table"
   ]
  },
  {
   "cell_type": "code",
   "id": "83d8c021",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "1 2 3 4 5\n",
      "2 4 6 8 10\n",
      "3 6 9 12 15\n",
      "4 8 12 16 20\n",
      "5 10 15 20 25\n",
      ""
     ]
    }
   ],
   "source": [
    "# Outer loop = rows (1 to 5), inner loop = columns (1 to 5)\n",
    "for i in range(1, 6):\n",
    "    for j in range(1, 6):\n",
    "        # Print on the same line; start a new line after the last column\n",
    "        print(i * j, end=\" \" if j < 5 else \"\\n\")"
   ]
  }
