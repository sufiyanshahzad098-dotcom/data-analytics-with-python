   "source": [
    "## QUESTION 1: Working with Lists"
   ]
  },
  {
   "cell_type": "code",
   "id": "cbd796da",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "All numbers in the list:\n",
      "12\n",
      "7\n",
      "25\n",
      "8\n",
      "14\n",
      "3\n",
      "40\n",
      "19\n",
      "6\n",
      "\n",
      "Sum of all numbers: 134\n",
      "\n",
      "Even numbers in the list:\n",
      "12\n",
      "8\n",
      "14\n",
      "40\n",
      "6\n",
      ""
     ]
    }
   ],
   "source": [
    "# Create a list called numbers containing at least 8 integers\n",
    "numbers = [12, 7, 25, 8, 14, 3, 40, 19, 6]\n",
    "\n",
    "# Variable to keep the running total of all numbers\n",
    "total = 0\n",
    "\n",
    "# Loop 1: print every number and add it to the total\n",
    "print(\"All numbers in the list:\")\n",
    "for num in numbers:\n",
    "    print(num)\n",
    "    total += num\n",
    "\n",
    "# Print the sum of all numbers\n",
    "print(\"\\nSum of all numbers:\", total)\n",
    "\n",
    "# Loop 2: print only the even numbers (conditional statement inside the loop)\n",
    "print(\"\\nEven numbers in the list:\")\n",
    "for num in numbers:\n",
    "    if num % 2 == 0:  # a number is even if dividing by 2 leaves no remainder\n",
    "        print(num)"
   ]
  },
