   "source": [
    "## QUESTION 5: Word Frequency Counter"
   ]
  },
  {
   "cell_type": "code",
   "id": "e204ef52",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Enter a sentence: The quick brown fox jumps over the lazy dog the fox\n",
      "\n",
      "Word frequency:\n",
      "the: 3\n",
      "quick: 1\n",
      "brown: 1\n",
      "fox: 2\n",
      "jumps: 1\n",
      "over: 1\n",
      "lazy: 1\n",
      "dog: 1\n",
      ""
     ]
    }
   ],
   "source": [
    "# Ask the user to enter a sentence\n",
    "sentence = input(\"Enter a sentence: \")\n",
    "\n",
    "# Convert the sentence into a list of words (lowercase so \"The\" and \"the\" match)\n",
    "words = sentence.lower().split()\n",
    "\n",
    "# Dictionary to count how many times each word appears\n",
    "word_count = {}\n",
    "\n",
    "for word in words:\n",
    "    word = word.strip(\".,!?;:\\\"'\")  # remove punctuation around the word\n",
    "    if word == \"\":\n",
    "        continue\n",
    "    if word in word_count:\n",
    "        word_count[word] += 1\n",
    "    else:\n",
    "        word_count[word] = 1\n",
    "\n",
    "# Print the word frequency\n",
    "print(\"\\nWord frequency:\")\n",
    "for word, count in word_count.items():\n",
    "    print(f\"{word}: {count}\")"
   ]
  },
