   "metadata": {},
   "source": [
    "## QUESTION 2: Dictionary Basics"
   ]
  },
  {
   "cell_type": "code",
   "id": "b3856664",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Student details:\n",
      "name: Ayesha Khan\n",
      "age: 20\n",
      "course: Computer Science\n",
      "marks: [78, 65, 82]\n",
      "\n",
      "Average marks: 75.00\n",
      "Result: Passed\n",
      ""
     ]
    }
   ],
   "source": [
    "# Create a dictionary called student (marks holds a list of 3 marks)\n",
    "student = {\n",
    "    \"name\": \"Ayesha Khan\",\n",
    "    \"age\": 20,\n",
    "    \"course\": \"Computer Science\",\n",
    "    \"marks\": [78, 65, 82]\n",
    "}\n",
    "\n",
    "# Loop 1: print all keys and their values\n",
    "print(\"Student details:\")\n",
    "for key, value in student.items():\n",
    "    print(f\"{key}: {value}\")\n",
    "\n",
    "# Loop 2: calculate the average of the marks using a loop\n",
    "marks_total = 0\n",
    "for mark in student[\"marks\"]:\n",
    "    marks_total += mark\n",
    "\n",
    "average = marks_total / len(student[\"marks\"])\n",
    "print(f\"\\nAverage marks: {average:.2f}\")\n",
    "\n",
    "# Pass if average >= 50, otherwise Fail\n",
    "if average >= 50:\n",
    "    print(\"Result: Passed\")\n",
    "else:\n",
    "    print(\"Result: Failed\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "127b1c2e",
   "metadata": {},
   "source": [
    "## QUESTION 3: List of Dictionaries"
   ]
  },
  {
   "cell_type": "code",
   "id": "ce3191d9",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Employee details:\n",
      "Name: Ali Raza, Department: Engineering, Salary: 120000\n",
      "Name: Sara Ahmed, Department: Marketing, Salary: 95000\n",
      "Name: Bilal Hussain, Department: Finance, Salary: 105000\n",
      "Name: Fatima Noor, Department: Engineering, Salary: 135000\n",
      "\n",
      "Highest paid employee: Fatima Noor (135000)\n",
      "Total salary expense: 455000\n",
      ""
     ]
    }
   ],
   "source": [
    "# Create a list called employees; each employee is a dictionary\n",
    "employees = [\n",
    "    {\"name\": \"Ali Raza\", \"department\": \"Engineering\", \"salary\": 120000},\n",
    "    {\"name\": \"Sara Ahmed\", \"department\": \"Marketing\", \"salary\": 95000},\n",
    "    {\"name\": \"Bilal Hussain\", \"department\": \"Finance\", \"salary\": 105000},\n",
    "    {\"name\": \"Fatima Noor\", \"department\": \"Engineering\", \"salary\": 135000}\n",
    "]\n",
    "\n",
    "# Loop 1: print details of all employees\n",
    "print(\"Employee details:\")\n",
    "for emp in employees:\n",
    "    print(f\"Name: {emp['name']}, Department: {emp['department']}, Salary: {emp['salary']}\")\n",
    "\n",
    "# Loop 2: find the employee with the highest salary and add up all salaries\n",
    "highest_paid = employees[0]   # assume the first employee is highest to start\n",
    "total_salary = 0\n",
    "\n",
    "for emp in employees:\n",
    "    total_salary += emp[\"salary\"]\n",
    "    if emp[\"salary\"] > highest_paid[\"salary\"]:  # comparison logic\n",
    "        highest_paid = emp\n",
    "\n",
    "print(f\"\\nHighest paid employee: {highest_paid['name']} ({highest_paid['salary']})\")\n",
    "print(f\"Total salary expense: {total_salary}\")"
   ]
  },
